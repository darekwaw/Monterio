{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MonterioDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "Origins": [ "http://localhost:3010", "http://localhost:3000" ]
  },
  "Storage": {
    "Local": {
      "UploadPath": "uploads"
    }
  },
  "EmployeeJwt": {
    "Secret": "monterio-employee-jwt-secret-key-minimum-32-characters-long!",
    "Issuer": "monterio-api",
    "Audience": "monterio-employees",
    "ExpiryMinutes": 480
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
