# Wzór pliku .env — install.ps1 generuje prawdziwy .env z losowymi sekretami. Nie commituj .env.
MONTERIO_VERSION=1.2.0
# Port interfejsu www (kontener web) i port API (dla aplikacji mobilnej instalatora).
MONTERIO_WEB_PORT=3010
MONTERIO_PORT=5020
# Adres, pod którym użytkownicy otwierają interfejs www (trafia do linków/QR oceny klienta).
MONTERIO_PUBLIC_URL=http://localhost:3010
# Sekrety: wygeneruj losowe (SA: min. 12 znaków, litery+cyfry; JWT/RATING: min. 32 znaki).
MONTERIO_SA_PASSWORD=
MONTERIO_JWT_SECRET=
MONTERIO_RATING_SECRET=
